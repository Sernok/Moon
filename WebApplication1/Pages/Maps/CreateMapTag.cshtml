@page
@using WebApplication1.Models
@model CreateMapTagModel

@{
	ViewData["Title"] = "Добавление тега карты";
}
<hr class="mb-1" />
<h1 class="display-4 fortext">Добавление объекта</h1>
<hr class="mb-4" />
<div class="row g-1">
	<div class="col-md-6 col-sm-12">
		<div class="border border-1 border-secondary rounded" style="position: relative;">
			<svg id="map-svg" width="100%" height="auto" viewBox="0 0 1724 1728" version="1.1" xml:space="preserve" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" style="position: relative;">
				<defs id="defs" />
					<g id="layer-fon">
						<image id="fon" x="0" y="0" width="1724" height="1728" xlink:href="/images/main/Map.png" preserveAspectRatio="none" />
					</g>
					<g id="layer-view">
					<polygon id="view-polygon" points="0 0" />
					</g>
					<g>
			<i id="map-icon" style="position: absolute; pointer-events: none;"></i>
					</g>
			</svg>

			<div class="d-flex justify-content-center m-1">
				<button id="clear-path" class="btn btn-info">Очистить регион</button>
			</div>
		</div>
	</div>
	<div class="col-md-6 col-sm-12 fortext">
		<div class="border border-1 border-secondary rounded p-2">
			<form id="edit-form" asp-page="/Maps/CreateMapTag" method="post" enctype="application/x-www-form-urlencoded" class="row g-3">
				<div class="col-12">
					<label for="title" class="form-label">Заголовок</label>
					<input id="title" name="title" type="text" class="form-control">
				</div>
				<div class="col-12">
					<label for="description" class="form-label fortext">Описание</label>
					<textarea id="description" name="description" class="form-control" rows="3"></textarea>
				</div>

				<div class="col-12">
					<div class="btn-group">
						<button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="ListButton">
							Выберите значение
						</button>

						<ul id="construction" class="dropdown-menu">
							<li>
								<a class="dropdown-item" value="Жилые модули">
									<i class="bi bi-house-door-fill pe-1"></i>
									Жилые модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Спортивные модули">
									<i class="bi bi-bicycle  pe-1">
									</i>
									Спортивные модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Административные модули">
									<i class="bi bi-building pe-1"></i>
									Административные модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Медицинские модули">
									<i class="bi bi-heart-pulse-fill  pe-1">
									</i>
									Медицинские модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Исследовательские модули">
									<i class="bi bi-binoculars-fill  pe-1">
									</i>
									Исследовательские модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Ремонтные модули">
									<i class="fa-solid fa-screwdriver-wrench  pe-1">
									</i>
									Ремонтные модули
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Космодромы">
									<i class="fa-solid fa-rocket  pe-1">
									</i>
									Космодромы
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Вышки связи">
									<i class="fa-solid fa-satellite-dish pe-1">
									</i>
									Вышки связи
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Плантации">
									<i class="fa-solid fa-spa pe-1">
									</i>
									Плантации
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Мусорные полигоны">
									<i class="fa-solid fa-trash pe-1">
									</i>
									Мусорные полигоны
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Производственные предприятия">
									<i class="fa-solid fa-industry pe-1">
									</i>Производственные предприятия
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Астрономические площадки">
									<i class="fa-solid fa-eye pe-1">
									</i>Астрономические площадки
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Солнечные электростанции">
									<i class=" fa-solid fa-solar-panel pe-1">
									</i>Солнечные электростанции
								</a>
							</li>
							<li>
								<a class="dropdown-item" value="Добывающие шахты">
									<i class="fa-solid fa-helmet-safety pe-1">
									</i>Добывающие шахты
								</a></a>
							</li>
						</ul>
						<input type="hidden" id="Construction" name="Construction">
					</div>
					<input id="form-path" name="path" type="hidden" />
				</div>
				<input id="IconClass" name="IconClass" type="hidden" />

				<div class="d-flex justify-content-end">
					<button type="submit" class="btn btn-primary me-1">Сохранить</button>
					<a asp-page="/Map" class="btn btn-primary me-1">Отменить</a>
				</div>
				<input type="hidden" id="Icon" name="Icon">
				<input type="hidden" id="CenterIcon" name="CenterIcon">
 
			</form>
		</div>
	</div>
</div>

<script>
	  document.querySelectorAll('.dropdown-item').forEach(item => {
		item.addEventListener('click', function () {
		  let selectedValue = this.getAttribute('value');
		  document.getElementById('Construction').value = selectedValue;

		  const button = document.getElementById("ListButton");
		  button.textContent = selectedValue;

		  let idValue;
		  let iconClass = [];
		  let centerIcon = [];

		  switch (selectedValue) {
			case "Жилые модули":
			  iconClass = ["bi", "bi-house-door-fill"];
			  idValue = 1;
			  break;
			case "Спортивные модули":
			  iconClass = ["bi", "bi-bicycle"];
			  idValue = 2;
			  break;
			case "Административные модули":
			  iconClass = ["bi", "bi-building"];
			  idValue = 3;
			  break;
			case "Медицинские модули":
			  iconClass = ["bi", "bi-heart-pulse-fill"];
			  idValue = 4;
			  break;
			case "Исследовательские модули":
			  iconClass = ["bi", "bi-binoculars-fill"];
			  idValue = 5;
			  break;
			case "Ремонтные модули":
			  iconClass = ["fa-solid", "fa-screwdriver-wrench"];
			  idValue = 6;
			  break;
			case "Космодромы":
			  iconClass = ["fa-solid", "fa-rocket"];
			  idValue = 7;
			  break;
			case "Вышки связи":
			  iconClass = ["fa-solid", "fa-satellite-dish"];
			  idValue = 8;
			  break;
			case "Плантации":
			  iconClass = ["fa-solid", "fa-spa"];
			  idValue = 9;
			  break;
			case "Мусорные полигоны":
			  iconClass = ["fa-solid", "fa-trash"];
			  idValue = 10;
			  break;
			case "Производственные предприятия":
			  iconClass = ["fa-solid", "fa-industry"];
			  idValue = 11;
			  break;
			case "Астрономические площадки":
			  iconClass = ["fa-solid", "fa-eye"];
			  idValue = 12;
			  break;
			case "Солнечные электростанции":
			  iconClass = ["fa-solid", "fa-solar-panel"];
			  idValue = 13;
			  break;
			case "Добывающие шахты":
			  iconClass = ["fa-solid", "fa-helmet-safety"];
			  idValue = 14;
			  break;
			default:
			  idValue = 0;
			  console.warn("Неизвестное значение selectedValue:", selectedValue);
			  return;
		  }

		  const polygons = document.querySelectorAll("#layer-view polygon");

		  polygons.forEach(polygon => {
			const points = polygon.getAttribute("points")
			  .split(" ")
			  .map(p => p.split(",").map(Number));

			if (points.length > 1) {
			  const centerX = points.reduce((sum, p) => sum + p[0], 0) / points.length;
			  const centerY = points.reduce((sum, p) => sum + p[1], 0) / points.length;
			  centerIcon = [centerX, centerY];
			  console.log(centerIcon)

			  // Удаляем предыдущие иконки
			  const existingIcons = polygon.parentNode.querySelectorAll('.polygon-icon');
			  existingIcons.forEach(icon => icon.remove());

			  const iconContainer = document.createElementNS("http://www.w3.org/2000/svg", "foreignObject");
			  iconContainer.setAttribute("x", centerX - 12);
			  iconContainer.setAttribute("y", centerY - 12);
			  iconContainer.setAttribute("width", "100");
			  iconContainer.setAttribute("height", "100");
			  iconContainer.classList.add("polygon-icon"); // Класс для удаления старых иконок

			  const div = document.createElement("div");
			  div.style.width = "100%";
			  div.style.height = "100%";
			  div.style.display = "flex";
			  div.style.alignItems = "center";
			  div.style.justifyContent = "center";
			  div.style.color = "darkgreen";
			  const iconElement = document.createElement("i");
			  iconElement.classList.add(...iconClass);
			  iconElement.style.fontSize = "100px";

			  div.appendChild(iconElement);
			  iconContainer.appendChild(div);
			  polygon.parentNode.appendChild(iconContainer);
			}
		  });
	// Передаем массив иконок в строку с пробелами для скрытого поля
	document.getElementById('IconClass').value = iconClass.join(' ');
		  document.getElementById('Icon').value = idValue;
			document.getElementById('CenterIcon').value = centerIcon.join(' ')

		});
	  });
</script>