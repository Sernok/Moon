@page
@using WebApplication1.Models
@model CreateMapTagModel
@{
    ViewData["Title"] = "Добавление тега карты";
}

<h1 class="display-4">Добавление тега карты</h1>
<hr class="mb-5" />
<div class="row g-1">
    <div class="col-md-6 col-sm-12">
        <div class="border border-1 border-secondary rounded">
            <svg id="map-svg" width="100%" height="auto" viewBox="0 0 1724 1728" version="1.1" xml:space="preserve" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg">
            <defs id="defs" />
            <g id="layer-fon">
            <image id="fon" x="0" y="0" width="1724" height="1728" xlink:href="/images/main/Map.png" preserveAspectRatio="none" />
            </g>
            <g id="layer-view">
            <polygon id="view-polygon" points="0 0" />
            </g>
            </svg>
            <div class="d-flex justify-content-center m-1">
                <button id="clear-path" class="btn btn-info">Очистить регион</button>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-sm-12">
        <div class="border border-1 border-secondary rounded p-2">
            <form id="edit-form" asp-page="/Maps/CreateMapTag" method="post" enctype="application/x-www-form-urlencoded" class="row g-3">
                <div class="col-12">
                    <label for="title" class="form-label">Заголовок</label>
                    <input id="title" name="title" type="text" class="form-control">
                </div>

                <div class="col-12">
                    <label for="description" class="form-label">Описание</label>
                    <textarea id="description" name="description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <label for="construction" class="form-label">Тип объекта</label>
                    <div class="btn-group">
                        <button type="button" class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            Action
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#!" id="1">Жилые модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="2">Спортивные модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="3">Административные модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="4">Медицинские модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="5">Исследовательские модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="6">Ремонтные модули</a></li>
                            <li><a class="dropdown-item" href="#!" id="7">Космодромы</a></li>
                            <li><a class="dropdown-item" href="#!" id="8">Вышки связи</a></li>
                            <li><a class="dropdown-item" href="#!" id="9">Плантации</a></li>
                            <li><a class="dropdown-item" href="#!" id="10">Мусорные полигоны</a></li>
                            <li><a class="dropdown-item" href="#!" id="11">Производственные предприятия</a></li>
                            <li><a class="dropdown-item" href="#!" id="12">Астрономические площадки</a></li>
                            <li><a class="dropdown-item" href="#!" id="13">Солнечные электростанции</a></li>
                            <li><a class="dropdown-item" href="#!" id="14">Добывающие шахты</a></li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Добывающие шахты" id="14">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Добывающие шахты
                                    </a>
                                </label>
                            </li>
                        </ul>
                    </div>
                    <textarea id="construction" name="construction" class="form-control" rows="3"></textarea>
                </div>
                <input id="form-path" name="path" type="hidden" />

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary me-1">Сохранить</button>
                    <a asp-page="/Map" class="btn btn-primary me-1">Отменить</a>
                </div>
            </form>
        </div>
    </div>
</div>
