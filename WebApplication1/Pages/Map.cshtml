                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Солнечные электростанции" id="13">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Солнечные электростанции
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Добывающие шахты" id="14">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Добывающие шахты
                                    </a>
                                </label>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="addObject">ОК</button>
                </div>
            </div>
        </div>
    </div>



</div>

@if (Model.GeoTags != null && Model.GeoTags.Any())
{
    <script>
        document.addEventListener("DOMContentLoaded", function() { // один слушатель DOMContentLoaded

            @foreach (var tag in Model.GeoTags)
            {
                <text>
                    // Создаем переменную для ID элемента.  Важно экранировать кавычки внутри строки JavaScript.
            var elementId = "@Html.Raw(tag.Id)";
                var iconId="@Html.Raw(tag.Icon)";
document.getElementById(elementId).addEventListener("click", function () {
                // alert(iconId);
    let iconElement = document.createElement('i');
    if (iconId === "2") {
        iconElement.classList.add('bi', 'bi-house-door-fill');
    } else {
        iconElement.classList.add('bi', 'bi-bicycle');
    }

    let alertBox = document.createElement('div');
    alertBox.style.position = 'fixed';
    alertBox.style.top = '50%';
    alertBox.style.left = '50%';
    alertBox.style.transform = 'translate(-50%, -50%)';
    alertBox.style.padding = '20px';
    alertBox.style.backgroundColor = 'white';
    alertBox.style.border = '1px solid black';
    document.body.appendChild(alertBox);

    setTimeout(() => alertBox.remove(), 20000); // Автоудаление через 2 сек
});
 

                </text>
            }
        });
    </script>
}


 