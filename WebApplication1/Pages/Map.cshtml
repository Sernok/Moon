                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Медицинские модули
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Исследовательские модули" id="5">
                                    <span></span> <!-- Заменяемый элемент -->
