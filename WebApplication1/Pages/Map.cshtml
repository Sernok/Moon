                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Вышки связи" id="8">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Вышки связи
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Плантации" id="9">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Плантации
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Мусорные полигоны" id="10">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Мусорные полигоны
                                    </a>
                                </label>
                            </li>

                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Производственные предприятия" id="11">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Производственные предприятия
                                    </a>
                                </label>
                            </li>
                        </ul>
                    </div>

                    <div class="thirdlink">
                        <ul class="list-unstyled  thirdtext">
                            <p> </p>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Астрономические площадки" id="12">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
