                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Мусорные полигоны
                                    </a>
                                </label>
                            </li>

                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Производственные предприятия" id="11">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
