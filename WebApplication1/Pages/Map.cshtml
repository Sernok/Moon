                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Ремонтные модули" id="6">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Ремонтные модули
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Космодромы" id="7">
