                                    <a class="links link-overlay" href="#!">
                                        Жилые модули
                                    </a>
                                </label>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Спортивные модули" id="2">
                                    <span></span>
                                    <a class="links link-overlay" href="#!">
                                        Спортивные модули
                                    </a>
                            </li>
                            <li>
                                <label>
                                    <input type="radio" name="selectedLinks" value="Административные модули" id="3">
                                    <span></span> <!-- Заменяемый элемент -->
                                    <a class="links link-overlay" href="#!">
                                        Административные модули
                                    </a>
                                </label>
                            </li>
                            <li>
